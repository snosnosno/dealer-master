# ============================================
# 딜러마스터 환경변수 템플릿
# 이 파일을 .env.local 로 복사한 뒤 실제 값을 채우세요.
# .env.local 은 절대 커밋하지 마세요 (.gitignore 처리됨).
# ============================================

# --- Supabase (신규 프로젝트, UNIQN과 분리) ---
# Dashboard > Project Settings > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 서버 전용. 절대 NEXT_PUBLIC_ 접두사를 붙이지 말 것 (붙이면 브라우저로 유출됨)
SUPABASE_SECRET_KEY=

# --- Anthropic (AI 채점: Haiku 4.5) ---
ANTHROPIC_API_KEY=

# --- 토스페이먼츠 정기결제 (가맹점 심사 통과 후 발급) ---
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# --- 앱 설정 ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 1인 운영이므로 role 테이블 없이 관리자 이메일 하드코딩 (핸드오프 §6-4)
ADMIN_EMAIL=
